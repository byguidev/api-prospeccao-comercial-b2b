<mxCell id="note" value="&lt;b&gt;Legenda e referências lógicas&lt;/b&gt;&lt;br&gt;Linha tracejada = referência lógica por código (sem relacionamento JPA).&lt;br&gt;Empresa.naturezaJuridica → Natureza&lt;br&gt;Empresa.qualificacaoResponsavel → Qualificacao&lt;br&gt;Estabelecimento.cnaeFiscalPrincipal/Secundaria → Cnae&lt;br&gt;Estabelecimento.municipio → Municipio; .pais → Pais&lt;br&gt;Estabelecimento.motivoSituacaoCadastral → Motivo&lt;br&gt;Socio.pais → Pais; Socio.qualificacao* → Qualificacao&lt;br&gt;Simples.cnpjBasico = Empresa.cnpjBasico (1:1 lógico, sem FK)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fillColor=#FFF9DB;strokeColor=#E9D58A;spacing=8;" vertex="1" parent="1">
<mxGeometry x="40" y="955" width="520" height="160" as="geometry"/>
